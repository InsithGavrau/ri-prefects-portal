{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ri-prefects-portal",
  "compatibility_date": "2026-07-01",
  "main": "./src/worker.js",
  "cache": {
    "enabled": false
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
